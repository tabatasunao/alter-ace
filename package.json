{
  "name": "alter-ace",
  "private": true,
  "version": "1.0.0",
  "description": "ALTER: a top-down 2D real-time mass battle game",
  "license": "MIT",
  "homepage": "https://tabatasunao.github.io/alter-ace/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabatasunao/alter-ace.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "vitest run --config vitest.docs.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
